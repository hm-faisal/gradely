		{
			"name": "Auth",
			"item": [
				{
					"name": "Register Student",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Student User\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Registers a student. Generates a unique student email on every run and saves the returned tokens."
					},
					"response": [],
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const stamp = Date.now();",
									"pm.collectionVariables.set(\"studentEmail\", `student-${stamp}@example.com`);",
									"pm.collectionVariables.set(\"studentPassword\", \"Password123!\");"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
									"const json = pm.response.json();",
									"pm.test(\"Returns user and tokens\", () => {",
									"  pm.expect(json.data.user.email).to.eql(pm.collectionVariables.get(\"studentEmail\"));",
									"  pm.expect(json.data.tokens.accessToken).to.be.a(\"string\");",
									"});",
									"pm.collectionVariables.set(\"accessToken\", json.data.tokens.accessToken);",
									"pm.collectionVariables.set(\"refreshToken\", json.data.tokens.refreshToken);",
									"pm.collectionVariables.set(\"studentId\", json.data.user.id);"
								]
							}
						}
					],
					"auth": {
						"type": "noauth"
					}
				},
