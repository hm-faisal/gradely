# Server Configuration
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/gradely"

# JWT Authentication Secrets & Expirations
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-min-32-chars"
JWT_ACCESS_TOKEN_EXPIRY="15m"
JWT_REFRESH_TOKEN_EXPIRY="7d"

# Default Admin Account (Seeded by `pnpm run db:seed`)
ADMIN_NAME="Gradely Admin"
ADMIN_EMAIL="admin@gradely.com"
ADMIN_PASSWORD="Admin@12345"

# Rate Limiting Configuration (express-rate-limit)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=15

