// use prisma-8
enum Role {
  STUDENT = "STUDENT"
  ADMIN = "ADMIN"
  REVIEWER = "REVIEWER"
}

enum UserStatus {
  ACTIVE = "ACTIVE"
  INACTIVE = "INACTIVE"
  BANNED = "BANNED"
  DELETED = "DELETED"
}

enum SubmissionStatus {
  PENDING = "PENDING"
  APPROVED = "APPROVED"
  REJECTED = "REJECTED"
}

model User {
  id          String                     @id @default(uuid())
  name        String
  email       String                     @unique
  password    String
  role        Role                       @default(STUDENT)
  status      UserStatus                 @default(ACTIVE)
  submissions Submission[]               @relation("StudentSubmissions")
  reviewed    Submission[]               @relation("ReviewedBy")
  feedbacks   Feedback[]                 @relation("ReviewerFeedbacks")
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
}

model Submission {
  id          String                     @id @default(uuid())
  projectName String
  repoUrl     String                     @unique
  liveLink    String
  description String
  status      SubmissionStatus           @default(PENDING)
  feedback    String?

  studentId   String
  student     User                       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  reviewerId  String?
  reviewer    User?                      @relation("ReviewedBy", fields: [reviewerId], references: [id])
  reviewedAt  TimestamptzString?

  reviewFeedback Feedback?

  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  @@unique([studentId, projectName])
  @@index([status, createdAt])
}

model Feedback {
  id           String                     @id @default(uuid())
  content      String

  submissionId String                     @unique
  submission   Submission                 @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  reviewerId   String
  reviewer     User                       @relation("ReviewerFeedbacks", fields: [reviewerId], references: [id])

  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([reviewerId, createdAt])
}
